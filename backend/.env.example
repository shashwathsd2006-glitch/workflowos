# WorkFlowOS backend environment
# Copy to .env and adjust as needed.

# development | production | test
ENVIRONMENT=development

# Uvicorn bind address
HOST=127.0.0.1
PORT=8000

# Verbose error output
DEBUG=true

# SQLite database file (relative paths resolve from backend/)
DATABASE_PATH=data/workflowos.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Discovery: minimum sequence similarity (0.0 - 1.0) to treat two
# activity sequences as the same repeated workflow
SIMILARITY_THRESHOLD=0.75

# --- Phase 5: AI Understanding ---
# Provider used for workflow understanding: ollama | mock
# Tests force mock via the test environment; production/demo uses ollama.
AI_PROVIDER=ollama

# Local Ollama server (this project never calls cloud AI APIs)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Seconds to wait for the model before giving up.
# A cold 7B model takes 30-120s to load, so keep this generous. A short
# timeout is the most common cause of a failed "Understand with AI" call.
OLLAMA_TIMEOUT=300

# --- Phase 8: demo mode -------------------------------------------------
# When true, unconfigured integrations fall back to clearly-labelled local
# demo adapters so the whole pipeline can be demonstrated without credentials.
# DEMO_MODE enables clearly-labelled local stand-ins (gmail_demo, slack_demo).
# It exists for automated tests and offline exploration. Leave it OFF for a
# real run: the application then talks only to real providers, and mock
# adapters are neither listed nor runnable.
DEMO_MODE=false

# --- Phase 8: scheduler + background worker ------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=5
WORKER_ENABLED=true
WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=5
JOB_MAX_RETRIES=2
JOB_RETRY_BACKOFF_SECONDS=5
JOB_STALE_AFTER_SECONDS=900

# --- Google (Gmail + Calendar) -------------------------------------------
# PREFERRED: leave the three variables below blank and drop the OAuth client
# file at:  backend/credentials/google-client-secret.json
# It is gitignored and read at startup. The app then reports which source it
# used (credential_source = "credentials-file" or "environment").
#
# The variables are only needed to override the file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match a redirect URI registered in Google Cloud Console, exactly:
#   http://localhost:8000/api/integrations/gmail/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback

# Optional: read the OAuth client JSON from a non-default location.
GOOGLE_CREDENTIALS_FILE=credentials/google-client-secret.json

# Where the OAuth callback sends the browser afterwards (Settings page).
FRONTEND_URL=http://localhost:3000

# --- Gmail behaviour ------------------------------------------------------
# Optional explicit search. Leave blank and the query is derived from
# DEMO_SENDER_EMAIL / DEMO_RECIPIENT_EMAIL plus the subject "WorkflowOS Demo".
# GMAIL_READ_QUERY=subject:"WorkflowOS Demo" from:sender@example.com
# Fallback recipient/subject for a reply when neither can be derived from the
# message that was read.
GMAIL_REPLY_TO=
GMAIL_REPLY_SUBJECT=

# --- Phase 8: Slack ------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/settings

# --- Phase 8: integration behaviour --------------------------------------
# Fernet key used to encrypt OAuth tokens at rest. Leave blank to generate a
# local key file (backend/data/.integration_key) automatically.
INTEGRATION_TOKEN_KEY=
INTEGRATION_REQUEST_TIMEOUT=20
GMAIL_POLL_INTERVAL_SECONDS=60
CALENDAR_POLL_INTERVAL_SECONDS=60

# --- Demo: an email that arrives from an external account -----------------
# WorkFlowOS monitors the connected Gmail account. The demo email must be a
# genuine incoming message, so it is sent BY HAND from a different account.
# The backend cannot send as an account it is not authorised for, and the
# preparation script refuses to send it for you.
#
# DEMO_SENDER_EMAIL    the external/test Gmail account that sends the email
# DEMO_RECIPIENT_EMAIL the connected WorkFlowOS mailbox (the one to watch)
#
# The workflow searches for:
#   subject:"WorkflowOS Demo" from:<DEMO_SENDER_EMAIL>
# so it never picks up the replies WorkFlowOS itself sends, which live in the
# same mailbox. A reply goes back to the sender of the message that was read.
#
# Subject: WorkflowOS Demo
# Body:    I was charged twice for invoice 88213 and need a refund today.
DEMO_SENDER_EMAIL=
DEMO_RECIPIENT_EMAIL=
