# WorkflowOS — environment configuration
#
# This file documents EVERY environment variable the backend reads
# (backend/app/config.py is the single source of truth). It contains no real
# credentials: every secret below is a placeholder you replace locally.
#
# The backend loads its own .env file from the backend/ directory:
#
#   cp backend/.env.example backend/.env
#
# The frontend reads .env.local from frontend/:
#
#   cp frontend/.env.example frontend/.env.local
#
# .env files are git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# development | production | test
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
# Verbose error output
DEBUG=true

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite database file. Relative paths resolve from the backend/ directory.
DATABASE_PATH=data/workflowos.db

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Where the OAuth callback returns the browser to after consent
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Discovery
# ---------------------------------------------------------------------------
# Minimum sequence similarity (0.0 - 1.0) for two activity sequences to be
# treated as the same repeated workflow
SIMILARITY_THRESHOLD=0.75

# ---------------------------------------------------------------------------
# Local AI (Ollama) — no cloud AI provider is ever contacted
# ---------------------------------------------------------------------------
# Provider used for workflow understanding: ollama | mock
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Seconds to wait for the model. Keep this generous: a cold 7B model can take
# 30-120s to load, and a short timeout is the most common cause of a failed
# "Understand with AI" call.
OLLAMA_TIMEOUT=300

# ---------------------------------------------------------------------------
# Google OAuth (Gmail) — supply your own credentials
# ---------------------------------------------------------------------------
# PREFERRED: leave GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET blank and drop your
# OAuth client JSON at:
#     backend/credentials/google-client-secret.json
# It is git-ignored and read at startup. The app then reports which source it
# used (credential_source = "credentials-file" or "environment").
#
# The variables below are only needed to override that file.
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
# Must match a redirect URI registered in Google Cloud Console, exactly:
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
# Optional: point at a credentials file in a non-default location
GOOGLE_CREDENTIALS_FILE=credentials/google-client-secret.json

# ---------------------------------------------------------------------------
# Gmail behaviour
# ---------------------------------------------------------------------------
# How often the observation pass polls the connected mailbox
GMAIL_POLL_INTERVAL_SECONDS=60
# Optional explicit search. Leave blank and the query is derived from
# DEMO_SENDER_EMAIL / DEMO_RECIPIENT_EMAIL plus the subject "WorkflowOS Demo".
# GMAIL_READ_QUERY=subject:"WorkflowOS Demo" from:sender@example.com
# Fallback recipient/subject for replies when none can be derived
GMAIL_REPLY_TO=
GMAIL_REPLY_SUBJECT=

# ---------------------------------------------------------------------------
# Demo email (two real Gmail accounts)
# ---------------------------------------------------------------------------
# WorkflowOS watches the connected mailbox and reads an email that arrives
# FROM a second, external account. The backend cannot send as an account it is
# not authorised for, so the incoming demo email is sent BY HAND.
#
# DEMO_SENDER_EMAIL    the external account that sends the demo email
# DEMO_RECIPIENT_EMAIL the connected WorkFlowOS mailbox (the one to watch)
#
# The workflow then searches for:
#   subject:"WorkflowOS Demo" from:<DEMO_SENDER_EMAIL> to:<DEMO_RECIPIENT_EMAIL>
# so it never picks up the replies WorkflowOS itself sends.
#
# Suggested demo message:
#   Subject: WorkflowOS Demo
#   Body:    I was charged twice for invoice 88213 and need a refund today.
DEMO_SENDER_EMAIL=external.sender@example.com
DEMO_RECIPIENT_EMAIL=connected.mailbox@example.com

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# When true, unconfigured integrations fall back to clearly-labelled local
# stand-ins (gmail_demo, slack_demo, calendar_demo) so the pipeline can be
# explored without credentials. Leave it OFF for a real run: the application
# then talks only to real providers and the stand-ins are neither listed nor
# runnable.
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Scheduler and background worker
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=5
WORKER_ENABLED=true
WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=5
JOB_MAX_RETRIES=2
JOB_RETRY_BACKOFF_SECONDS=5
JOB_STALE_AFTER_SECONDS=900

# ---------------------------------------------------------------------------
# Integration security and timeouts
# ---------------------------------------------------------------------------
# Fernet key used to encrypt OAuth tokens at rest. Leave blank to generate a
# local key file automatically at backend/data/.integration_key (git-ignored).
INTEGRATION_TOKEN_KEY=
INTEGRATION_REQUEST_TIMEOUT=20
CALENDAR_POLL_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Slack (optional, not required for the Gmail demo)
# ---------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/settings

# ---------------------------------------------------------------------------
# Frontend (Next.js reads .env.local, not .env)
# ---------------------------------------------------------------------------
# Base URL of the FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
